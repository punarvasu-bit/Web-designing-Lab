<!DOCTYPE html>
<html>
    <h1 align="center">Hotel Room Booking Form</h1>
    <form>

    
        
        <label>Full Name:</label>
        <input type="text" name=" Full Name">
        

        <br>
        <label>Email:</label>
        <input type="text" name="Email">
        </br>

        <br>
    
        <label>Phone:</label>
        <input type="number" name="Phone">
        </br>
        <br>
            <label>Check in Date:</label>
        <input type="date" name="Check in Date">
        </br>
        
        <br>
            <label>Check out Date:</label>
        <input type="date" name="Check out date">

        </br>
        
        
        <br>
        <label>Room type:</label>
        <select>
            <option>Single Room</option>
            <option>Double room</option>
            <option>Multi room</option>
            
        </select>
        </br>
        <br>
        <label>Number of guests:</label>
        <input type="number" name="Number of guests">
        </br>
        <br>
            <label>Special Request:</label>
        <textarea name="Special Request" rows="4" cols="40"></textarea>
        </br>
        
        <br>
        <input type="Submit" value="Book now">
        <input type="Reset" value="Go back">
        </br>

    </form>
</html>
